# TEMPLATE — substitute the placeholders before installing:
#   sed -e "s|/home/youruser|$HOME|g" -e "s|^User=youruser|User=$USER|" \
#       -e "s|^Group=youruser|Group=$USER|" systemd/coding-model-server.service | sudo tee /etc/systemd/system/coding-model-server.service
# Paths assume the checkout lives at $HOME/Dev/coding-model-server; adjust
# WorkingDirectory and ExecStart if yours is elsewhere.
[Unit]
Description=Coding Model Multi-Agent Server (FastAPI)
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=youruser
Group=youruser
WorkingDirectory=/home/youruser/Dev/coding-model-server
ExecStart=/home/youruser/Dev/coding-model-server/venv/bin/python -m coding_model_server.server
Restart=always
RestartSec=10
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

# CUDA environment — pinned to 13.2 (verified 2026-09-16).
#
# This block used to pin 12.8 with the note "NOT 13.x (MMQ compiler bug on
# Blackwell/sm_120a)". That pin was silently INEFFECTIVE: the tools/ binaries
# link libcudart.so.13 / libcublas.so.13, and cuda-12.8/lib64 ships only
# .so.12, so the loader fell through to 13.2 regardless. This stack has in
# fact been running on CUDA 13.2 since the 2026-08-13 build, with no MMQ
# faults. The original warning applied to 13.1, not 13.2.
#
# Pinned to an explicit versioned path rather than /usr/local/cuda, because
# that is an update-alternatives symlink in AUTO mode (priorities 126/131/132)
# and would move on its own if a higher-priority CUDA package is installed.
#
# If you ever move back to 12.8, you must change these lines AND rebuild
# tools/ against 12.8 in the same step — changing one alone does nothing.
Environment="CUDA_HOME=/usr/local/cuda-13.2"
Environment="LD_LIBRARY_PATH=/usr/local/cuda-13.2/lib64"
Environment="PATH=/usr/local/cuda-13.2/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

# Model configuration. Prefer ~/.config/coding-model-server/.env (keeps secrets out of
# the repo); repo-local .env is kept as a fallback during migration.
EnvironmentFile=-/home/youruser/Dev/coding-model-server/.env
EnvironmentFile=-/home/youruser/.config/coding-model-server/.env

# Resource limits
LimitNOFILE=65536
LimitMEMLOCK=infinity
NoNewPrivileges=true

# Security hardening — keep it light here because llama.cpp + CUDA need broad
# syscall access. Tighten further (SystemCallFilter, MemoryDenyWriteExecute)
# only after testing they don't break your GPU backend.
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

# GPU access: this unit is system-mode (deployed to /etc/systemd/system/
# per setup.sh). NVIDIA devices are accessible to root by default; no
# DevicePolicy/DeviceAllow needed. If you ever want to re-tighten device
# access, add `DevicePolicy=closed` plus explicit `DeviceAllow=` lines
# for /dev/nvidia*. User-mode operation is no longer supported.

[Install]
WantedBy=multi-user.target
