[Unit]
Description=Qwen Autonomous Orchestrator Daemon
# Wait for the inference server before starting — we'll talk to its
# /v1/chat/completions endpoint once the real planner agent lands in 1b.
After=network.target qwen-server.service
Wants=qwen-server.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=keith-merrill
Group=keith-merrill
WorkingDirectory=/home/keith-merrill/Dev/qwen-server
ExecStart=/home/keith-merrill/Dev/qwen-server/venv/bin/python orchestrator_daemon.py
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# No CUDA needed — daemon is a pure Python coordinator. Inference happens
# inside qwen-server.service which already owns the GPU. Keeping the env
# minimal here also means we can restart this independently without
# touching CUDA at all.
Environment="PYTHONUNBUFFERED=1"

# Configuration (poll interval, log level, Jira creds in 1c) lives in .env.
# Prefer ~/.config/qwen-server/.env; repo-local .env kept as migration fallback.
EnvironmentFile=-/home/keith-merrill/Dev/qwen-server/.env
EnvironmentFile=-/home/keith-merrill/.config/qwen-server/.env

# Resource limits
LimitNOFILE=65536
# NoNewPrivileges intentionally NOT set. With Linux 6.17+ Ubuntu kernels,
# unprivileged user namespaces are confined under the AppArmor profile
# `unprivileged_userns` unless a dedicated profile transitions in.
# /etc/apparmor.d/bwrap exists for that — `flags=(unconfined) { userns, }` —
# but profile transitions are privilege gains, so NoNewPrivileges=yes
# blocks them, leaving bwrap stuck in `unprivileged_userns` without
# CAP_SYS_ADMIN. bwrap then can't mount tmpfs / re-bind /proc and reports
# "No permissions to create new namespace". Dropping NoNewPrivileges
# restores the transition so bwrap runs unconfined inside its own userns.
# The other hardening flags below stay in place; bwrap itself provides
# the actual LLM-test isolation.

# Security hardening — this daemon runs LLM-generated pytest subprocesses, so
# it is the highest-risk service. Tighten aggressively; broaden ReadWritePaths
# if your task workspace or repo lives elsewhere.
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectSystem=strict
ReadWritePaths=/home/keith-merrill/Dev/qwen-server /tmp /var/tmp
# Block read access to credential / SSH paths in the orchestrator user's
# home. ProtectSystem=strict + ReadWritePaths already prevent writes
# outside the workspace, but those flags don't restrict reads. With
# QWEN_ALLOW_UNSANDBOXED_TESTS=1 (or a sandbox bypass), LLM-generated
# code running as this UID would otherwise have read access to ssh keys
# and gnupg material. Belt-and-suspenders since bwrap is the primary
# isolation; this is the secondary defense.
InaccessiblePaths=-/home/keith-merrill/.ssh -/home/keith-merrill/.gnupg -/home/keith-merrill/.aws -/home/keith-merrill/.config/git
# LLM-generated tests are sandboxed separately via bubblewrap — see
# qwen_autonomous/executor.py::run_tests. Install `bubblewrap` on the host:
#   apt install bubblewrap
# Or set QWEN_ALLOW_UNSANDBOXED_TESTS=1 to opt out (not recommended).

[Install]
WantedBy=multi-user.target
