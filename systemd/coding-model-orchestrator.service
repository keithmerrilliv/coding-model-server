[Unit]
Description=Coding Model Autonomous Orchestrator Daemon
# Wait for the inference server before starting — we'll talk to its
# /v1/chat/completions endpoint once the real planner agent lands in 1b.
After=network.target coding-model-server.service
Wants=coding-model-server.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=keith-merrill
Group=keith-merrill
WorkingDirectory=/home/keith-merrill/Dev/coding-model-server
ExecStart=/home/keith-merrill/Dev/coding-model-server/venv/bin/python -m coding_model_server.orchestrator_daemon
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# No CUDA needed — daemon is a pure Python coordinator. Inference happens
# inside coding-model-server.service which already owns the GPU. Keeping the env
# minimal here also means we can restart this independently without
# touching CUDA at all.
Environment="PYTHONUNBUFFERED=1"

# Configuration (poll interval, log level, Jira creds in 1c) lives in .env.
# Prefer ~/.config/coding-model-server/.env; repo-local .env kept as migration fallback.
EnvironmentFile=-/home/keith-merrill/Dev/coding-model-server/.env
EnvironmentFile=-/home/keith-merrill/.config/coding-model-server/.env

# Resource limits
LimitNOFILE=65536

# Security hardening — this daemon runs LLM-generated pytest subprocesses, so
# it is the highest-risk service. Tighten aggressively; broaden ReadWritePaths
# if your task workspace or repo lives elsewhere.
#
# IMPORTANT: bwrap's user-namespace mount setup is fragile under systemd
# isolation on Linux 6.17+ Ubuntu kernels. The actual sandboxing for
# LLM-generated tests comes from bwrap+seccomp (see
# coding_model_autonomous/executor.py::_wrap_in_sandbox + seccomp_filter.py); the
# flags below harden the *orchestrator process itself*, which only spawns
# bwrap. They must NOT interfere with the child userns or bwrap's procfs
# mount.
#
# Hardening flags deliberately disabled for bwrap compatibility (validated
# 2026-05-04 by direct invocation: 4072 pytest tests passed under bwrap+
# seccomp after these flags were turned off):
#
#   - NoNewPrivileges=no           Required so bwrap can profile-transition
#                                  to /etc/apparmor.d/bwrap (which grants
#                                  the `userns` cap). Several Protect*
#                                  flags below would implicitly set NNP=yes,
#                                  hence the explicit override.
#   - PrivateTmp=no                systemd's private-tmp setup requires a
#                                  service mount namespace (MS_PRIVATE
#                                  propagation) that breaks userns procfs
#                                  mount.
#   - ProtectSystem=no             Same — strict read-only rootfs forces a
#                                  service mount namespace incompatible
#                                  with bwrap's child mount setup.
#   - ProtectControlGroups=no      Implies MountAPIVFS=yes which interacts
#                                  badly with bwrap's --unshare-cgroup.
#   - ProtectProc=default          `invisible` (hidepid on parent procfs)
#                                  causes EPERM when child userns mounts a
#                                  fresh procfs on kernel 6.17+.
#
# Hardening flags also omitted (they would block bwrap's namespace setup,
# unshare-class syscalls, clock setup, or UTS namespace):
#   - RestrictNamespaces=yes       blocks CLONE_NEWUSER
#   - ProtectKernelTunables=yes    implicit SystemCallFilter blocks unshare
#   - ProtectClock=yes             seccomp blocks bwrap's clock_* setup
#   - ProtectHostname=yes          UTS namespace conflict with --unshare-uts
NoNewPrivileges=no
PrivateTmp=no
ProtectSystem=no
ProtectControlGroups=no
ProtectProc=default
# 2026-05-04 update: ProtectKernelLogs/ProtectKernelModules/LockPersonality/
# RestrictRealtime/RestrictSUIDSGID also REMOVED. Each of those installs an
# implicit SystemCallFilter (per systemd.exec(5)) that is inherited by
# child processes — including bwrap's child userns. The implicit filter
# does not block mount(2) directly, but the cumulative restrictions
# manifest as `bwrap: Can't mount proc on /newroot/proc: Operation not
# permitted` from inside the systemd service context, even though the
# same bwrap+seccomp invocation works from a regular shell. Validated
# 2026-05-04 by direct invocation: 4072 pytest tests passed under
# bwrap+seccomp from a non-systemd shell. The orchestrator's bwrap+seccomp
# wrapper (coding_model_autonomous/executor.py + seccomp_filter.py) provides all
# the isolation needed for LLM-generated code; these process-level
# hardening flags add no defense in the bwrap-isolated path and break
# the path entirely.
# Block read access to credential / SSH paths in the orchestrator user's
# home. With ProtectSystem disabled (above), there's no broad rootfs
# protection; this is the primary defense for those specific paths if
# the bwrap sandbox is ever bypassed (e.g. CODING_MODEL_ALLOW_UNSANDBOXED_TESTS=1).
# The .env paths hold ADMIN_API_KEY / JIRA_API_TOKEN / ANTHROPIC_API_KEY /
# GEMINI_API_KEY (DEV-174). Blocking them here is safe: EnvironmentFile
# above is read by the systemd MANAGER before this namespace exists, so the
# daemon still receives the values — only in-process reads (i.e. LLM-authored
# test code running unsandboxed) are denied.
InaccessiblePaths=-/home/keith-merrill/.ssh -/home/keith-merrill/.gnupg -/home/keith-merrill/.aws -/home/keith-merrill/.config/git -/home/keith-merrill/.config/coding-model-server -/home/keith-merrill/Dev/coding-model-server/.env
# LLM-generated tests are sandboxed separately via bubblewrap — see
# coding_model_autonomous/executor.py::run_tests. Install `bubblewrap` on the host:
#   apt install bubblewrap
# Or set CODING_MODEL_ALLOW_UNSANDBOXED_TESTS=1 to opt out (not recommended).

[Install]
WantedBy=multi-user.target
