# TEMPLATE — substitute the placeholders before installing:
#   sed -e "s|/home/youruser|$HOME|g" -e "s|^User=youruser|User=$USER|" \
#       -e "s|^Group=youruser|Group=$USER|" systemd/coding-model-apple-docs-refresh.service | sudo tee /etc/systemd/system/coding-model-apple-docs-refresh.service
# Paths assume the checkout lives at $HOME/Dev/coding-model-server; adjust
# WorkingDirectory and ExecStart if yours is elsewhere.
[Unit]
Description=Refresh the Apple documentation RAG collection
# The refresh talks to /v1/memory/delete and /v1/memory on the local server, so
# it is pointless without it. Wants= rather than Requires= so a stopped server
# fails this run cleanly instead of dragging the unit into a dependency error.
Wants=coding-model-server.service
After=coding-model-server.service network-online.target

[Service]
Type=oneshot
User=youruser
WorkingDirectory=/home/youruser/Dev/coding-model-server
EnvironmentFile=-/home/youruser/Dev/coding-model-server/.env
Environment="PYTHONUNBUFFERED=1"
Environment="CODING_MODEL_SERVER_IP=127.0.0.1"
ExecStart=/home/youruser/Dev/coding-model-server/scraping/refresh_apple_docs.sh

# A crawl of ~30k pages at a polite delay runs several hours. Without this the
# default TimeoutStartSec would kill it mid-run — the same mismatch that makes
# `systemctl stop coding-model-orchestrator` SIGKILL a live spec.
TimeoutStartSec=8h

# Deliberately NOT Restart=on-failure. A failed refresh means either Apple
# changed their JSON or the server was down; retrying immediately would just
# re-crawl 30k pages to fail the same way. `systemctl list-units --failed`
# surfaces it, which is the point — a scheduled job that hides its failures is
# how the last two Apple-docs integrations rotted unnoticed.

[Install]
WantedBy=multi-user.target
