# TEMPLATE — substitute the placeholders before installing:
#   sed -e "s|/home/youruser|$HOME|g" -e "s|^User=youruser|User=$USER|" \
#       -e "s|^Group=youruser|Group=$USER|" systemd/coding-model-dashboard.service | sudo tee /etc/systemd/system/coding-model-dashboard.service
# Paths assume the checkout lives at $HOME/Dev/coding-model-server; adjust
# WorkingDirectory and ExecStart if yours is elsewhere.
[Unit]
Description=Coding Model Dashboard (static SPA server)
# The dashboard polls coding-model-server's /v1/* endpoints, but we only need the
# server to be reachable at request time — not started before the dashboard.
# Wants= without After= keeps the boot order independent and prevents the
# dashboard from waiting on CUDA / model load to come up.
After=network.target
Wants=coding-model-server.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=youruser
Group=youruser
WorkingDirectory=/home/youruser/Dev/coding-model-server
ExecStart=/home/youruser/Dev/coding-model-server/venv/bin/python scripts/serve_dashboard.py
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

# No CUDA, no GPU. Pure static-file server.
Environment="PYTHONUNBUFFERED=1"

# Bind/port + dashboard root come from .env so operators can change the
# port without editing this unit. Defaults in serve_dashboard.py:
#   CODING_MODEL_DASHBOARD_HOST=127.0.0.1  (0.0.0.0 is the LAN opt-in, DEV-192)
#   CODING_MODEL_DASHBOARD_PORT=3001
#   CODING_MODEL_DASHBOARD_ROOT=<repo>/dashboard/dist
EnvironmentFile=-/home/youruser/Dev/coding-model-server/.env
EnvironmentFile=-/home/youruser/.config/coding-model-server/.env

# Resource limits
LimitNOFILE=4096
NoNewPrivileges=true

# Security hardening — this service serves static files and has no need
# for write access anywhere on disk, no kernel surfaces, and no
# credentials.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# No write paths — this process never writes. ProtectSystem=strict makes
# the entire filesystem read-only by default; we don't need to add any
# ReadWritePaths.

[Install]
WantedBy=multi-user.target
