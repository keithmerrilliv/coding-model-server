[Unit]
Description=Qwen Resource Monitor (Power & DB Size)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/keith-merrill/Dev/qwen-server
ExecStart=/usr/bin/python3 /home/keith-merrill/Dev/qwen-server/monitor_resources.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
