<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent template for the Mac runner.
     1. Copy to ~/Library/LaunchAgents/com.codingmodel.runner.plist
     2. Replace km4 with your macOS username if different.
     3. Adjust ProgramArguments to point at your venv's python.
     4. Load: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.codingmodel.runner.plist
        Unload: launchctl bootout   gui/$(id -u)/com.codingmodel.runner
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codingmodel.runner</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/km4/Dev/coding-model-server/venv/bin/python</string>
    <string>-m</string>
    <string>mac_runner.server</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/km4/Dev/coding-model-server</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- xcodebuild, xcrun, swift must be on PATH -->
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/km4/Library/Logs/coding-model-runner.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/km4/Library/Logs/coding-model-runner.err.log</string>
</dict>
</plist>
