<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent template for the Mac runner.
     1. Copy to ~/Library/LaunchAgents/com.codingmodel.runner.plist
     2. Replace km4 with your macOS username if different.
     3. Adjust ProgramArguments to point at your venv's python.
     4. Load: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.codingmodel.runner.plist
        Unload: launchctl bootout   gui/$(id -u)/com.codingmodel.runner
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codingmodel.runner</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/km4/Dev/qwen-server/venv/bin/python</string>
    <string>-m</string>
    <string>mac_runner.server</string>
  </array>

  <!-- NOT stale: the Mac checkout really lives at ~/Dev/qwen-server (the
       GitHub remote is still qwen-server.git). Renaming this without
       renaming the directory breaks the runner. See docs/SECURITY_MIGRATION.md. -->
  <key>WorkingDirectory</key>
  <string>/Users/km4/Dev/qwen-server</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- xcodebuild, xcrun, swift must be on PATH -->
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <!-- SuccessfulExit=false + ThrottleInterval: a bare KeepAlive=true made a
       fast-exiting runner (e.g. sys.exit(1) on an empty
       CODING_MODEL_RUNNER_API_KEY) a quiet crash-loop at launchd's ~10s
       default. Now a clean exit stays exited, and failures retry on a 30s
       floor that is visible in the logs. (DEV-167) -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/km4/Library/Logs/coding-model-runner.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/km4/Library/Logs/coding-model-runner.err.log</string>
</dict>
</plist>
