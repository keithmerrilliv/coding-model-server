# Mac-runner environment variables.
# Copy to ~/.config/coding-model-runner/.env and chmod 600.

# REQUIRED. Shared secret between this runner and the Linux orchestrator's
# MAC_RUNNER_API_KEY. The runner refuses to start if this is empty unless
# CODING_MODEL_RUNNER_ALLOW_UNAUTH=1 is set (dev only — don't use on shared networks).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CODING_MODEL_RUNNER_API_KEY=replace-me

# Bind address. 127.0.0.1 is the default and correct for the SSH-tunnel
# transport (ssh -R 5050:localhost:5050 linux-server). Change only if you
# want the runner reachable directly on a LAN.
CODING_MODEL_RUNNER_HOST=127.0.0.1
CODING_MODEL_RUNNER_PORT=5050

# Directories — defaults place data under ~/Library/Caches so macOS can
# evict on disk pressure. Override if you want persistent locations.
# CODING_MODEL_RUNNER_WORKTREE_ROOT=~/Library/Caches/coding-model-runner/worktrees
# CODING_MODEL_RUNNER_DERIVED_DATA=~/Library/Caches/coding-model-runner/DerivedData

# Path to the repo-map file. Defaults to ~/.config/coding-model-runner/repos.yml.
# CODING_MODEL_RUNNER_REPOS_FILE=~/.config/coding-model-runner/repos.yml

# Sandbox for LLM-authored builds/tests (DEV-126). On by default: swift/
# xcodebuild run under sandbox-exec with mac_runner/sandbox.sb, which makes
# credential paths (~/.ssh, keychains, this .env) unreadable and $HOME
# read-only outside the worktree/DerivedData/build caches. Set to 0 only to
# debug a build the profile breaks — and prefer fixing the profile.
# Exception, applied automatically: xcodebuild_test runs unsandboxed even
# when this is on — app-hosted XCTest hangs under sandbox-exec regardless of
# profile (DEV-403; replacement containment is DEV-417).
# CODING_MODEL_RUNNER_SANDBOX=1
# CODING_MODEL_RUNNER_SANDBOX_PROFILE=/path/to/custom.sb

# Dedicated signing keychain (DEV-398) and its password (DEV-415/DEV-416).
# Point at the actual .keychain-db file — the sandbox rule is a literal path
# match. Never use the login keychain here. The password lets the runner
# unlock the keychain at startup: keychains lock on every reboot, and a
# headless runner cannot answer the GUI prompt, so without it the first
# signed build after a restart fails with errSecInternalComponent.
# CODING_MODEL_RUNNER_SIGNING_KEYCHAIN=~/Library/Keychains/runner-signing.keychain-db
# CODING_MODEL_RUNNER_SIGNING_KEYCHAIN_PASSWORD=keychain-password
