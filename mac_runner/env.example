# Mac-runner environment variables.
# Copy to ~/.config/qwen-runner/.env and chmod 600.

# REQUIRED. Shared secret between this runner and the Linux orchestrator's
# MAC_RUNNER_API_KEY. The runner refuses to start if this is empty unless
# QWEN_RUNNER_ALLOW_UNAUTH=1 is set (dev only — don't use on shared networks).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
QWEN_RUNNER_API_KEY=replace-me

# Bind address. 127.0.0.1 is the default and correct for the SSH-tunnel
# transport (ssh -R 5050:localhost:5050 linux-server). Change only if you
# want the runner reachable directly on a LAN.
QWEN_RUNNER_HOST=127.0.0.1
QWEN_RUNNER_PORT=5050

# Directories — defaults place data under ~/Library/Caches so macOS can
# evict on disk pressure. Override if you want persistent locations.
# QWEN_RUNNER_WORKTREE_ROOT=~/Library/Caches/qwen-runner/worktrees
# QWEN_RUNNER_DERIVED_DATA=~/Library/Caches/qwen-runner/DerivedData

# Path to the repo-map file. Defaults to ~/.config/qwen-runner/repos.yml.
# QWEN_RUNNER_REPOS_FILE=~/.config/qwen-runner/repos.yml
