;; HARDENED CANDIDATE sandbox profile for mac_runner (DEV-527).
;;
;; This file is INERT until an operator swaps it in: Config.SANDBOX_PROFILE
;; reads mac_runner/sandbox.sb (or CODING_MODEL_RUNNER_SANDBOX_PROFILE), never
;; this name. Validate it (mac_runner/validate_sandbox_profile.sh) against a
;; real swift_test run, then swap it over sandbox.sb DURING A DISPATCH GAP —
;; sandbox-exec -f reads the file at dispatch time, so a bad profile fails the
;; very next build and is scored as a failing test run (test_runner.py). See the
;; DEPLOYMENT section at the bottom.
;;
;; What changed from the DEV-126 profile, and why (DEV-527, audit 2026-08-04):
;;
;;   The original is (allow default) with subtractive denies. That is right for
;;   the SYSTEM surface — xcodebuild's mach/IOKit/toolchain needs are vast and a
;;   default-deny profile that was never tuned bricks the runner. But it does
;;   NOT hold for writes or network, where the deny-list was enumerable and
;;   provably incomplete:
;;
;;     * WRITES: the only write deny was (subpath HOME). Everything OUTSIDE
;;       $HOME stayed writable — including /opt/homebrew/bin and /usr/local/bin,
;;       both on the runner's PATH and user-writable on Apple Silicon. Sandboxed
;;       test code could drop an executable `git`/`xcodebuild` there; the NEXT
;;       dispatch runs those UNSANDBOXED (workspace._git, integration.
;;       _tracked_paths) as the runner user, with CODING_MODEL_RUNNER_API_KEY in
;;       the environment and the SSH tunnel reachable. A full escape.
;;
;;     * NETWORK: there was no network rule at all, so a test body could read a
;;       credential the read deny-list did not name and POST it out.
;;
;;   Fix: keep (allow default) for the system surface, but INVERT writes (deny
;;   all, re-allow the build's own dirs — writes are enumerable in a way the
;;   system surface is not) and DENY IP network (local IPC over unix sockets
;;   stays, so the toolchain can still reach system daemons). Reads gain the
;;   named credential stores the original list missed.
;;
;; Parameters (supplied by the runner via sandbox-exec -D, see
;; frameworks.wrap_sandbox): HOME, WORKTREE, DERIVED_DATA, SIGNING_KEYCHAIN.
;;
;; Escape hatch: CODING_MODEL_RUNNER_SANDBOX=0 runs unwrapped.

(version 1)

(allow default)

;; ── Credential material: unreadable ─────────────────────────────────────────
;; The original six, plus the stores the 2026-08-04 audit found still readable
;; (~/.claude/.credentials.json is the concrete one — this repo's own tooling
;; keeps a live token there). A deny-list of secrets is only as current as the
;; last person who thought about it; the durable form is deny-by-default reads
;; under $HOME (see the commented block after the write rules), which needs a
;; real-build validation pass before it can ship.
(deny file-read*
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.aws"))
  (subpath (string-append (param "HOME") "/.gnupg"))
  (subpath (string-append (param "HOME") "/.config/coding-model-runner"))
  (literal (string-append (param "HOME") "/.netrc"))
  (subpath (string-append (param "HOME") "/Library/Keychains"))
  ;; DEV-527 additions:
  (subpath (string-append (param "HOME") "/.claude"))
  (subpath (string-append (param "HOME") "/.docker"))
  (subpath (string-append (param "HOME") "/.kube"))
  (subpath (string-append (param "HOME") "/.config/gh"))
  (literal (string-append (param "HOME") "/.gitconfig"))
  (literal (string-append (param "HOME") "/.git-credentials")))

;; ── Signing certificate: readable, and ONLY when a signing keychain is named ─
;; Unchanged from DEV-398 — do not regress. codesign runs inside this sandbox
;; and needs the certificate's private key; SBPL is last-match-wins, so this
;; re-allows exactly one keychain file over the blanket Keychains deny above.
;; Point SIGNING_KEYCHAIN at a DEDICATED keychain, never the login keychain.
;; Empty param -> "/nonexistent/..." (wrap_sandbox) -> matches nothing.
(allow file-read*
  (literal (param "SIGNING_KEYCHAIN"))
  (literal (string-append (param "SIGNING_KEYCHAIN") "-db"))
  (subpath (param "SIGNING_KEYCHAIN")))

;; ── Writes: deny by default, re-allow only the build's own directories ───────
;; INVERTED from the DEV-126 profile (which denied only $HOME). Writes are
;; enumerable, so deny-by-default is tractable here and closes the PATH-implant
;; escape. Anything a real build legitimately writes that is NOT below must be
;; added HERE (established empirically — a missing path fails the build with a
;; sandbox denial naming it).
(deny file-write*)

(allow file-write*
  (subpath (param "WORKTREE"))
  (subpath (param "DERIVED_DATA"))
  ;; SPM + clang module caches, xcodebuild scratch. Default WORKTREE_ROOT /
  ;; DERIVED_DATA live under Caches too, so custom locations are covered by the
  ;; params above and the defaults by these.
  (subpath (string-append (param "HOME") "/Library/Caches"))
  (subpath (string-append (param "HOME") "/Library/Developer"))
  (subpath (string-append (param "HOME") "/Library/org.swift.swiftpm"))
  ;; Ambient scratch a toolchain genuinely needs, previously covered only by the
  ;; blanket (allow default): the per-user temp/cache tree and world temp dirs.
  (subpath "/private/var/folders")
  (subpath "/private/tmp")
  (subpath "/private/var/tmp")
  (subpath "/tmp"))

;; Device writes: /dev/null, ttys, fd redirects — data writes to existing device
;; nodes only (not node creation), which is not a persistence/PATH vector.
(allow file-write-data
  (subpath "/dev"))

;; ── Durable reads hardening (OPTIONAL — validate before enabling) ────────────
;; The read deny-list above is still an enumeration. The durable form denies
;; reads by default UNDER $HOME and re-allows the toolchain's own dirs. It is
;; commented out because it must be proven not to break a real signed xcodebuild
;; run first (the system surface stays default-allow; only $HOME flips):
;;
;;   (deny file-read* (subpath (param "HOME")))
;;   (allow file-read*
;;     (subpath (param "WORKTREE"))
;;     (subpath (param "DERIVED_DATA"))
;;     (subpath (string-append (param "HOME") "/Library/Caches"))
;;     (subpath (string-append (param "HOME") "/Library/Developer"))
;;     (subpath (string-append (param "HOME") "/Library/org.swift.swiftpm"))
;;     (subpath (string-append (param "HOME") "/Library/MobileDevice"))
;;     (literal (param "SIGNING_KEYCHAIN"))
;;     (literal (string-append (param "SIGNING_KEYCHAIN") "-db")))

;; ── Network: no IP sockets from inside the sandbox ───────────────────────────
;; Exfiltration needs an outbound socket. SwiftPM dependency resolution is a
;; SEPARATE unsandboxed pre-step (build_resolve_cmd, DEV-294), so the sandboxed
;; build/test needs no internet. Deny IP in/out/bind (incl. localhost); leave
;; AF_UNIX alone (allowed by the default base) so the toolchain can still reach
;; launchd/syslog/etc. over local IPC, which is not an exfiltration path. A
;; denied connect() fails fast with EPERM — it does not hang.
(deny network-outbound (remote ip "*:*"))
(deny network-inbound (local ip "*:*"))
(deny network-bind (local ip "*:*"))
