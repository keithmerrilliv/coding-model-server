# Qwen Multi-Agent Server Configuration

# Server Settings
PORT=5000
HOST=0.0.0.0

# Model Configuration
MODEL_PATH=/home/keith-merrill/.lmstudio/models/unsloth/Qwen3-Coder-480B-A35B-Instruct-GGUF/Qwen3-Coder-480B-A35B-Instruct-UD-IQ1_M.gguf
MODEL_CONTEXT_SIZE=8192
MODEL_GPU_LAYERS=4

# Performance Optimization Settings
# Number of threads to use for inference (0 = auto-detect CPU cores)
MODEL_N_THREADS=24
# Number of threads to use for batch processing (0 = same as MODEL_N_THREADS)
MODEL_N_BATCH=512
# Enable flash attention for faster processing (if supported)
MODEL_FLASH_ATTENTION=true
# Use mmap for faster model loading (true/false)
MODEL_USE_MMAP=true
# Use mlock to keep model in RAM (true/false) - prevents spilling to disk
MODEL_USE_MLOCK=true
# Number of tokens to process at once (higher = faster but more memory)
MODEL_N_CTX_BATCH=2048

# CUDA (usually auto-detected)
# CUDA_HOME=/usr/local/cuda
# LD_LIBRARY_PATH=/usr/local/cuda/lib64
