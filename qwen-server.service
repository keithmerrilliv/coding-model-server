[Unit]
Description=Qwen Multi-Agent Server (FastAPI)
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=keith-merrill
Group=keith-merrill
WorkingDirectory=/home/keith-merrill/Dev/qwen-server
ExecStart=/home/keith-merrill/Dev/qwen-server/venv/bin/python server.py
Restart=always
RestartSec=10
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

# CUDA environment — use 12.8, NOT 13.x (13.x has MMQ compiler bug on Blackwell/sm_120a)
Environment="CUDA_HOME=/usr/local/cuda-12.8"
Environment="LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64"
Environment="PATH=/usr/local/cuda-12.8/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

# Model configuration. Prefer ~/.config/qwen-server/.env (keeps secrets out of
# the repo); repo-local .env is kept as a fallback during migration.
EnvironmentFile=-/home/keith-merrill/Dev/qwen-server/.env
EnvironmentFile=-%h/.config/qwen-server/.env

# Resource limits
LimitNOFILE=65536
LimitMEMLOCK=infinity
NoNewPrivileges=true

# Security hardening — keep it light here because llama.cpp + CUDA need broad
# syscall access. Tighten further (SystemCallFilter, MemoryDenyWriteExecute)
# only after testing they don't break your GPU backend.
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

# GPU access: this unit is system-mode (deployed to /etc/systemd/system/
# per setup.sh). NVIDIA devices are accessible to root by default; no
# DevicePolicy/DeviceAllow needed. If you ever want to re-tighten device
# access, add `DevicePolicy=closed` plus explicit `DeviceAllow=` lines
# for /dev/nvidia*. User-mode operation is no longer supported.

[Install]
WantedBy=multi-user.target
