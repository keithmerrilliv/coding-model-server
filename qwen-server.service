[Unit]
Description=Qwen Multi-Agent Server (FastAPI)
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
User=keith-merrill
Group=keith-merrill
WorkingDirectory=/home/keith-merrill/Dev/qwen-server
ExecStart=/home/keith-merrill/Dev/qwen-server/venv/bin/python server.py
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

# CUDA environment
Environment="CUDA_HOME=/usr/local/cuda-13.1"
Environment="LD_LIBRARY_PATH=/usr/local/cuda-13.1/lib64"
Environment="PATH=/usr/local/cuda-13.1/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

# Model configuration (override in .env file)
EnvironmentFile=-/home/keith-merrill/Dev/qwen-server/.env

# Resource limits
LimitNOFILE=65536
LimitMEMLOCK=infinity
NoNewPrivileges=true

# GPU access - disable device policy to allow all devices
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rwm
DeviceAllow=/dev/nvidiactl rwm
DeviceAllow=/dev/nvidia-modeset rwm
DeviceAllow=/dev/nvidia-uvm rwm
DeviceAllow=/dev/nvidia-uvm-tools rwm
DeviceAllow=char-drm rwm

[Install]
WantedBy=multi-user.target
