[Unit]
Description=Qwen Multi-Agent Server (FastAPI)
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# User= / Group= are not valid in --user units (the service already runs
# as the invoking user). Leaving them in caused status=216/GROUP and
# repeated restart-loop failures.
WorkingDirectory=/home/keith-merrill/Dev/qwen-server
ExecStart=/home/keith-merrill/Dev/qwen-server/venv/bin/python server.py
Restart=always
RestartSec=10
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

# CUDA environment — use 12.8, NOT 13.x (13.x has MMQ compiler bug on Blackwell/sm_120a)
Environment="CUDA_HOME=/usr/local/cuda-12.8"
Environment="LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64"
Environment="PATH=/usr/local/cuda-12.8/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

# Model configuration. Prefer ~/.config/qwen-server/.env (keeps secrets out of
# the repo); repo-local .env is kept as a fallback during migration.
EnvironmentFile=-/home/keith-merrill/Dev/qwen-server/.env
EnvironmentFile=-%h/.config/qwen-server/.env

# Resource limits
LimitNOFILE=65536
# NOTE: NoNewPrivileges, LimitMEMLOCK=infinity, and the Protect*/Restrict*/
# LockPersonality hardening directives are not usable in --user units —
# they require capabilities the user-mode systemd manager cannot grant
# (status=218/CAPABILITIES). Move this unit to a system-mode service if
# you want hardening back. GPU access also doesn't need device policy
# in user mode.

[Install]
WantedBy=default.target
