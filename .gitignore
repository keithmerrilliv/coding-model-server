venv/
# Every .env variant is a secret (real values, local overrides, timestamped
# backups like .env.bak-cors-*), so ignore them all — but keep the committed
# .env.example templates (root + dashboard) visible.
.env
.env.*
!**/.env.example
memory_db/
tasks_db/
tasks_db.bak.*/
*.log
tools/
tools.*.bak/
.DS_Store
appledeepdoc-mcp/
scraping/output
server_stats.csv*

# Consolidated runtime state + archived backups (new homes after the reorg)
var/
.archive/

# Local-only artifacts that should not land in the repo
.claude/
audit_report.md
recovered/
.pytest_cache/

# Mac-runner local caches (should never be in the repo)
Library/Caches/qwen-runner/

# Node / dashboard build artifacts
node_modules/
dashboard/dist/

# pip install -e . artifacts
*.egg-info/
build/
dist/
