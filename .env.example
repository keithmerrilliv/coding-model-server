# Coding Model Multi-Agent Server - Environment Variables Example
#
# Copy this file to ~/.config/coding-model-server/.env (NOT into the repo) to keep
# secrets out of version control. start.sh, start-client.sh, and the systemd
# units load from that path first and fall back to a repo-local .env only as
# a migration aid.

# ── Server Configuration ──
# Bind to loopback by default. The supported LAN pattern is loopback + an SSH
# tunnel (ssh -L 5000:localhost:5000 user@server). Change to 0.0.0.0 only with
# ADMIN_API_KEY set to a strong value AND the port firewalled to your subnet —
# the autonomous endpoints execute code, so an open port is an open shell.
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=localhost,127.0.0.1

# ── Authentication ──
# REQUIRED. Startup is refused (on every launch path, including bare uvicorn)
# if this is empty or still a known placeholder value.
# Generate a fresh key with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Local-dev opt-out: CODING_MODEL_ALLOW_UNAUTH=1 permits an empty key, but only
# on a loopback HOST — non-loopback clients are rejected per-request regardless.
ADMIN_API_KEY=

# ── Ingestion Security ──
INGEST_ALLOWED_DIR=/path/to/allowed/ingestion/dir
# Per-file byte cap for PDF/file ingestion (0 disables). Default 100MB.
INGEST_MAX_FILE_SIZE=104857600

# ── Model Defaults ──
# n_ctx / n_batch / n_ubatch / ngl / KV types are NOT env-tunable — each is a
# measured VRAM-budget decision, set per model in coding_model_server/config.py.
MODEL_N_THREADS=24
MODEL_N_THREADS_BATCH=32
# Max seconds for a single llama-server inference call. Must be >= the
# longest AUTONOMOUS_*_TIMEOUT or the inner request dies first (DEV-164).
LLAMA_SERVER_REQUEST_TIMEOUT=2700

# ── Model Paths (per-model overrides) ──
# MODEL_PATH_30B_TURBO=/path/to/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf
# MODEL_PATH_30B_FAST=/path/to/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf
# MODEL_PATH_80B_Q8=/path/to/Qwen3-Coder-Next-Q8_0-00001-of-00003.gguf
# MODEL_PATH_30B_HD=/path/to/Qwen3-Coder-30B-A3B-Instruct-Q8_0.gguf
# MODEL_PATH_480B_ULTRA=/path/to/Qwen3-Coder-480B-A35B-Instruct-UD-Q2_K_XL.gguf
# MODEL_PATH_230B=/path/to/MiniMax-M2.5-Q4_K_M.gguf
# MODEL_PATH_122B=/path/to/Qwen3.5-122B-A10B-Q4_K_M.gguf
# MODEL_PATH_35B=/path/to/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
# MODEL_PATH_27B=/path/to/Qwen3.6-27B-Q4_K_M.gguf
# MODEL_PATH_HYBRID_30B=/path/to/Nemotron-3-Nano-30B-A3B-Q4_K_M.gguf
# MODEL_PATH_30B_FLASH=/path/to/GLM-4.7-Flash-Q4_K_M.gguf

# ── Client Configuration ──
CODING_MODEL_SERVER_IP=192.168.50.101
CODING_MODEL_SERVER_PORT=5000
# Permission mode: 'default' (prompt for every action — safe), 'acceptEdits'
# (auto-approve file ops only), 'yolo' (auto-approve file ops; shell still
# prompts unless ALLOW_REMOTE_EXEC_YOLO=1 AND the command is allow-listed).
PERMISSION_MODE=default
# ALLOW_ALL=false                      # legacy alias for PERMISSION_MODE=yolo
# Shell execution is OFF by default. Set to true only in trusted environments.
ALLOW_SHELL_MODE=false
# COMMAND_WHITELIST=ls,pwd,cat,echo
# Unattended shell is gated by an ALLOW-LIST (read-only cmds, build/test tooling,
# read-only git; no shell metacharacters). Anything else prompts. Add your own
# build tools here if they aren't covered:
# EXTRA_AUTO_APPROVE_COMMANDS=bazel,just
# Native OpenAI function-calls for remote_exec (agents that define a native-tools
# prompt). Otherwise all tools are marker-based.
# CODING_MODEL_NATIVE_TOOLS=1

# ── RAG / Memory Tuning ──
# Max cosine DISTANCE for a hit to be injected (kept when distance <= this).
# Higher = looser. 0.35 was measured too strict to be useful: against the
# rebuilt Apple-docs collection, a near-verbatim sentence scored 0.2757 but
# "MTLDevice" and "How do I create an MTLDevice and command queue?" both
# returned nothing at all.
MEMORY_RELEVANCE_THRESHOLD=0.6
PDF_CHUNK_SIZE=1000
PDF_CHUNK_OVERLAP=200

# ── Scraping ──
# Directory holding the Apple Deep Docs MCP server (its main.py + venv/).
# Unset = repo-local tools/appledeepdoc-mcp.
# APPLE_DEEP_DOCS_PATH=/path/to/appledeepdoc-mcp

# ── Autonomous mode sandbox ──
# LLM-generated tests run inside bubblewrap by default. Install with
#   apt install bubblewrap   # Debian/Ubuntu
#   dnf install bubblewrap   # Fedora
# Setting this to 1 disables the sandbox — tests then run with the
# orchestrator's own privileges. Only use for local dev/debugging.
# CODING_MODEL_ALLOW_UNSANDBOXED_TESTS=0
#
# Node toolchain for the `node_test` framework (JS/TS specs using the built-in
# `node:test` runner). The sandbox masks /home and forces a minimal PATH, so a
# Node installed via nvm (under /home) is invisible and must be pointed at
# explicitly — the orchestrator binds this root into the sandbox and puts its
# bin first on PATH. Point at a Node install ROOT (the dir containing bin/node).
# If unset, the orchestrator falls back to whatever `node` is on its own PATH
# (usually nothing under systemd), and node_test specs can't run.
# NOTE: an nvm versioned path changes when you upgrade Node — update it then,
# or install Node under /opt for a stable path.
# CODING_MODEL_SANDBOX_NODE_ROOT=/home/youruser/.nvm/versions/node/v22.21.1

# ── Mac runner (for Swift / Xcode tests) ──
# Swift and Xcode tests can't run on Linux, so the orchestrator dispatches
# them over HTTP to a mac_runner service on your Mac. Recommended transport
# is an SSH reverse tunnel:
#   (from Mac) ssh -NT -R 5050:localhost:5050 user@linux-server
# With the tunnel up, leave MAC_RUNNER_URL as localhost:5050 on the Linux side.
# To keep the tunnel up across reboots and Wi-Fi drops, install the autossh
# LaunchAgent at mac_runner/com.codingmodel.tunnel.plist — see docs/SECURITY_MIGRATION.md.
MAC_RUNNER_URL=http://127.0.0.1:5050
# Must match CODING_MODEL_RUNNER_API_KEY in the Mac runner's ~/.config/coding-model-runner/.env.
MAC_RUNNER_API_KEY=

# ── Autonomous mode (Phase 1) ──
# Planner agent — defaults to dense_architect (Qwen3.6-27B). Any agent
# from /v1/models works; pick one tuned for structured output.
# AUTONOMOUS_PLANNER_AGENT=dense_architect
# AUTONOMOUS_PLANNER_TIMEOUT=900
# AUTONOMOUS_PLANNER_MAX_TOKENS=4000

# Task store + RAG paths (defaults under <repo>/var/)
# CODING_MODEL_TASKS_DB=/home/you/coding-model-server/var/tasks_db/tasks.sqlite
# CODING_MODEL_TASKS_WORKSPACE=/home/you/coding-model-server/var/tasks_db/specs
# CODING_MODEL_MEMORY_DB=/home/you/coding-model-server/var/memory_db

# Orchestrator daemon
# ORCHESTRATOR_POLL_INTERVAL=5
# ORCHESTRATOR_LOG_LEVEL=INFO

# Execution agents (Phase 2). Each role maps to an agent from /v1/models.
# AUTONOMOUS_ARCHITECT_AGENT=dense_architect
# AUTONOMOUS_IMPLEMENTER_AGENT=implementer
# AUTONOMOUS_REVIEWER_AGENT=reviewer
# AUTONOMOUS_ARCHITECT_TIMEOUT=2700
# AUTONOMOUS_IMPLEMENTER_TIMEOUT=1800
# AUTONOMOUS_REVIEWER_TIMEOUT=2700
# AUTONOMOUS_ARCHITECT_MAX_TOKENS=8000
# AUTONOMOUS_IMPLEMENTER_MAX_TOKENS=16000
# AUTONOMOUS_REVIEWER_MAX_TOKENS=16000
# AUTONOMOUS_MAX_RETRIES=5

# Design review: a reviewer critiques the architect's design and the architect
# gets a revision pass, BEFORE any code is written. On by default.
# AUTONOMOUS_DESIGN_REVIEW=1
# AUTONOMOUS_DESIGN_REVIEW_AGENT=reviewer
# AUTONOMOUS_DESIGN_REVIEW_MAX_TOKENS=8000
# AUTONOMOUS_DESIGN_REVIEW_MAX_REVISIONS=1

# Supervisor (meta-orchestrator: retry / fail / replan). OFF by default —
# setting AUTONOMOUS_SUPERVISOR_AGENT alone does nothing without this switch.
# AUTONOMOUS_SUPERVISOR=0
# AUTONOMOUS_SUPERVISOR_AGENT=supervisor
# AUTONOMOUS_SUPERVISOR_TIMEOUT=600
# AUTONOMOUS_SUPERVISOR_MAX_TOKENS=1500
# AUTONOMOUS_MAX_SUPERVISOR_TRANSITIONS=8

# Implementer sizing: MAX_TOKENS is a baseline; the real budget is
# TOKENS_BASE + TOKENS_PER_FILE * n_files, capped at CEILING. Above
# MANIFEST_FILE_THRESHOLD files the implementer switches to manifest+per-file mode.
# AUTONOMOUS_IMPLEMENTER_TOKENS_BASE=4000
# AUTONOMOUS_IMPLEMENTER_TOKENS_PER_FILE=1500
# AUTONOMOUS_IMPLEMENTER_MAX_TOKENS_CEILING=48000
# AUTONOMOUS_IMPLEMENTER_MODE=auto
# AUTONOMOUS_MANIFEST_FILE_THRESHOLD=8
# AUTONOMOUS_MANIFEST_MAX_TOKENS=8000
# AUTONOMOUS_PER_FILE_MAX_TOKENS=16000

# Daemon
# ORCHESTRATOR_POLL_INTERVAL=5
# ORCHESTRATOR_LOG_LEVEL=INFO

# ── Jira sync (optional, for autonomous mode) ──
# Leave empty to run with the in-memory FakeJiraClient (the orchestrator
# still works — it just doesn't talk to a real Jira instance). Fill all
# three of URL/EMAIL/TOKEN to enable the real client.
# JIRA_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your-api-token-from-id.atlassian.com
# JIRA_PROJECT_KEY=AUTO
# JIRA_SYNC_POLL_INTERVAL=10
# JIRA_SYNC_BATCH_SIZE=50

# ── /review multi-judge fan-out (optional) ──
# /review fans the uncommitted git diff to four reviewers in parallel:
# Claude, Gemini, the local Coding Model `reviewer`, and the local Coding Model
# `deep_reviewer`. Each external judge whose key is missing is silently
# skipped (a pre-flight notice tells you up front).
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...                   # GOOGLE_API_KEY also accepted
# REVIEW_CLAUDE_MODEL=claude-sonnet-4-6
# REVIEW_GEMINI_MODEL=gemini-3-pro
# REVIEW_TIMEOUT=120                   # per-judge seconds
# REVIEW_MAX_TOKENS=2000
# REVIEW_DIFF_MAX_BYTES=262144         # diff truncated above this size

# ── Phase b: adversarial test generation in autonomous mode (optional) ──
# When enabled, the orchestrator calls Gemini and/or Claude AFTER the
# local Coding Model reviewer's tests pass on retry-0 and asks each to write
# 3-7 additional `adversarial_test_*.py` files targeting edge cases
# Coding Model missed. The combined suite re-runs; a failure here downgrades
# the verdict and falls through to the implementer retry loop with
# the failing-test output as feedback.
#
# Provider modes:
#   gemini (default): single-provider Gemini, files `adversarial_test_*.py`.
#   claude:           single-provider Claude, same namespace.
#   both:             both providers fire sequentially. Each gets a
#                     provider-tagged filename prefix
#                     (`adversarial_test_claude_*.py` /
#                     `adversarial_test_gemini_*.py`) so they cannot
#                     overwrite each other's files. Doubles API cost
#                     AND doubles over-specification risk — measure each
#                     provider's false-FAIL rate separately first.
#
# Fail-open: per-provider errors (key, network, timeout, parse) are
# caught inside the loop; remaining providers still run. If every
# provider fails, the original Coding Model PASS stands.
#
# Reuses GEMINI_API_KEY / ANTHROPIC_API_KEY from the /review block above.
#
# Default OFF. Flip to 1 to opt in.
# AUTONOMOUS_ADVERSARIAL_TESTS_ENABLED=0
# AUTONOMOUS_ADVERSARIAL_PROVIDER=gemini       # gemini | claude | both
# AUTONOMOUS_ADVERSARIAL_GEMINI_MODEL=gemini-2.5-flash
# AUTONOMOUS_ADVERSARIAL_CLAUDE_MODEL=claude-sonnet-4-6
# AUTONOMOUS_ADVERSARIAL_MAX_TOKENS=8000
# AUTONOMOUS_ADVERSARIAL_TIMEOUT=300           # seconds, per provider call
