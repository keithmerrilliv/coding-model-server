# Qwen Multi-Agent Server - Environment Variables Example

# Server Configuration
QWEN_SERVER_IP=127.0.0.1
QWEN_SERVER_PORT=5000

# Model Configuration
MODEL_PATH=./models/model.gguf
MODEL_N_CTX=4096
MODEL_N_THREADS=0
MODEL_N_BATCH=512
MODEL_FLASH_ATTENTION=true
MODEL_USE_MMAP=true
MODEL_USE_MLOCK=false

# Security Settings
ALLOW_SHELL_MODE=true
COMMAND_WHITELIST=ls,pwd,cat,echo

# Scraping Configuration
APPLE_DEEP_DOCS_PATH=/Users/km4/Dev/Qwen/appledeepdoc-mcp/run.sh

# Memory Service Configuration (used for ingestion)
MEMORY_SERVICE_IP=192.168.50.101
MEMORY_SERVICE_PORT=5000

# Web Search Configuration
DDGS_MAX_RESULTS=5