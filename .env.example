# Qwen Multi-Agent Server Configuration

# Server Settings
PORT=5000
HOST=0.0.0.0

# Model Configuration
# Set this to the absolute path of your Qwen GGUF model file
# Supports tilde (~) expansion for home directory
# Example: MODEL_PATH=~/models/qwen2.5-coder-32b-instruct-q4_k_m.gguf
MODEL_PATH=/path/to/your/models/qwen2.5-coder-32b-instruct-q4_k_m.gguf
MODEL_CONTEXT_SIZE=32768
MODEL_GPU_LAYERS=99

# Memory Stability Settings
# Force model reload and cache eviction before every inference to prevent OOM
# Set to 'true' if experiencing CUDA out-of-memory errors during long sessions
VRAM_CRITICAL=false

# Security
# Admin API key required for /v1/admin/unload (leave empty to disable auth)
ADMIN_API_KEY=your-secret-key-here

# CORS (comma-separated origins, default "*")
# CORS_ORIGINS=*

# Ingest path restriction (leave empty to allow any absolute path)
# INGEST_ALLOWED_DIR=/path/to/allowed/directory

# Memory Service
# Cosine distance threshold for relevance filtering (lower = stricter)
# MEMORY_RELEVANCE_THRESHOLD=0.35

# Model Paths (override hardcoded defaults)
# MODEL_PATH_CODER_30B=/path/to/your/coder-30b.gguf
# MODEL_PATH_QWEN_32B=/path/to/your/qwen-32b.gguf
# MODEL_PATH_QWEN_480B=/path/to/your/qwen-480b.gguf
# MODEL_PATH_QWEN_14B=/path/to/your/qwen-14b.gguf

# CUDA (usually auto-detected)
# CUDA_HOME=/usr/local/cuda
# LD_LIBRARY_PATH=/usr/local/cuda/lib64